#!/bin/bash
# =============================================================================
# Sweep cell: target 38_TNFalpha (3 chains) x method fk-steering
#
# Generated by tools/make_cells.py. The logic lives in tools/cell_worker.sh,
# which is pushed to $RUN_ROOT/tools/ once; this file only declares the cell.
#
# Allowance: 02:00:00 on one gpu:h200:1. Identical for every cell, which is how
# the methods are matched on GPU-hours rather than on sample count.
# =============================================================================
#SBATCH --job-name=cxa_tnf_fk
#SBATCH --partition=gpu
#SBATCH --gres=gpu:h200:1
#SBATCH --cpus-per-task=12
#SBATCH --mem=96G
#SBATCH --time=02:00:00

# S15: an explicit seed, distinct per cell, recorded with every design and
# score this job emits. seed = 20261105 + 3 = 20261108
export TARGET="38_TNFalpha"
export METHOD="fk-steering"
export SEED=20261108
export NSAMPLES=4
export CELL_TAG="tnf_fk"
export EXTRA_OVERRIDES=""

source "/scratch/$USER/complexa_armB_20261105/tools/cell_worker.sh"
