#!/bin/bash
# =============================================================================
# Sweep cell: target 33_TrkA (1 chain) x method Generate and Hallucinate, repo-internal variant
#
# Generated by tools/make_cells.py. The logic lives in tools/cell_worker.sh,
# which is pushed to $RUN_ROOT/tools/ once; this file only declares the cell.
#
# Allowance: 02:00:00 on one gpu:a100:1. Identical for every cell, which is how
# the methods are matched on GPU-hours rather than on sample count.
# =============================================================================
#SBATCH --job-name=cxa_trka_gh
#SBATCH --partition=gpu
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=12
#SBATCH --mem=96G
#SBATCH --time=02:00:00

# S15: an explicit seed, distinct per cell, recorded with every design and
# score this job emits. seed = 20261105 + 10 = 20261115
export TARGET="33_TrkA"
export METHOD="best-of-n"
export SEED=20261115
export NSAMPLES=4
export CELL_TAG="trka_gh"
export EXTRA_OVERRIDES="++refinement.algorithm=sequence_hallucination"

source "/scratch/$USER/complexa_armB_20261105/tools/cell_worker.sh"
