# Ignore rules designed from what this workspace actually contains.
# Each entry says why it is excluded. R8 requires the reasoning to be visible.

# --- credentials / operator identity -------------------------------------
# connector_config.json carries the operator's cluster user and account.
# AGENTS.md says to use it and not to read it for anything else; it must not
# be committed. The .example file is safe and IS committed.
connector_copy/compute/connector_config.json

# --- machine-local caches, not readable source ---------------------------
__pycache__/
*.pyc

# --- large binary artifacts -----------------------------------------------
# Apptainer images, model checkpoints and folded-structure archives are large
# binaries that cannot be read usefully in a diff and are reproducible from
# the recorded commands.
*.sif
*.ckpt
*.pt
*.pth
*.tar
*.tar.gz
*.tgz
*.zip

# --- built environments ---------------------------------------------------
# Anything pip/uv/conda materialises locally is a build product, not source.
.venv/
venv/
env_build/

# NOTE on what is deliberately NOT ignored:
#   jobs/*.sbatch        - job scripts I author; the primary record of what ran
#   sacct/*              - scheduler output saved per S11; small text
#   logs/*               - fetched job stdout; the evidence behind every claim
#   results/*.csv, *.json - emitted records and curves, small text
#   connector_copy/compute/audit.log, jobs.jsonl - the connector's own trail

# --- third-party mirror: what is kept and what is not ---------------------
# The Proteina-Complexa source is mirrored at commit
# 8fc6f5c85b38a2585ffaac555e708576dc4e8533 so the code this run depended on is
# readable here. Two parts of that checkout are excluded:
#   assets/   ~114 MB of target structure data shipped by the repo. It is data,
#             not source, it is unchanged from upstream, and PROJECT.md tells
#             me to use it exactly as shipped rather than re-slicing it.
#   .git/     ~111 MB of upstream history; the commit hash above identifies the
#             tree more usefully than a vendored object store.
third_party/Proteina-Complexa/assets/
third_party/*/.git/
